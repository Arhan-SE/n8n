      "parameters": {
        "promptType": "define",
        "text": "=Topic: {{ $json.query }}\n\nResearch:\n{{ $json.results.map(item => JSON.stringify(item, null, 2)).join('\\n\\n') }}\n",
        "options": {
          "systemMessage": "=Overview\n\nYou are a professional newsletter section writer. Your job: write one standalone section of a business newsletter.\n\nInstructions\n\nStart with a clear section heading, then the content.\n\nNo overall title, intro, or conclusion.\n\nKeep it as short and sharp as possible—easy for a busy reader to finish quickly.\n\nTone: professional, expert, engaging.\n\nCite facts, data, or quotes with real, clickable URLs only. Never invent sources.\n\nStructure for clarity and brevity.\n\nThe section should be small and really small"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        1888,
        0
      ],
      "id": "316f2ebc-701f-47fe-869a-2b9d7a807c3f",
      "name": "Section Writer Agent"
    },
    {
